{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "types": [
            "node"
        ],
        "strict": true,
        "noEmit": true,
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": [
        "src"
    ]
}